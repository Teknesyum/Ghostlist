<Window x:Class="Ghostlist.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Ghostlist.App"
        xmlns:views="clr-namespace:Ghostlist.App.Views"
        Title="{local:Loc app.title}" Icon="Assets/ghostlist.ico"
        Width="1600" Height="1000" MinWidth="1280" MinHeight="860"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}" Foreground="{StaticResource TextBody}" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="7" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="52"/><Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3300F3FF"/>
                                <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#30FF00EA"/>
                                <Setter Property="Foreground" Value="{StaticResource NeonPink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextHint}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,1"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextLabel}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="#3300F3FF" BorderThickness="1"
                                CornerRadius="12" Padding="18,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A00F3FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3300F3FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8000F3FF"/>
                                <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <DataTemplate x:Key="FindingRow">
            <Border x:Name="row" Background="Transparent" CornerRadius="8" Padding="0,4" ToolTip="{Binding Title}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" HorizontalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource RowText}" Text="{Binding Title}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource RowText}" Foreground="{StaticResource TextDim}" Text="{Binding Subtitle}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource RowText}" FontFamily="{StaticResource FontMono}"
                               FontWeight="Bold" Foreground="{StaticResource NeonPink}" Text="{Binding Confidence}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource RowText}" Text="{Binding StatusText}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter TargetName="row" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="row" Property="ToolTip" Value="{Binding LockedText}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="FindingItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A00F3FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3300F3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryHeader" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource H3}" Text="{Binding Name.Header}"/>
                                        <Border Margin="10,0,0,0" Padding="8,1" CornerRadius="6" Background="#1AB026FF" BorderBrush="#50B026FF" BorderThickness="1">
                                            <TextBlock FontFamily="{StaticResource FontMono}" FontWeight="Bold" FontSize="13"
                                                       Foreground="{StaticResource NeonPurple}" Text="{Binding Name.Count}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource QuietButton}" Content="{local:Loc btn.categorySelect}" Command="{Binding Name.SelectCommand}"/>
                                        <Button Style="{StaticResource QuietButton}" Content="{local:Loc btn.categoryClear}" Command="{Binding Name.ClearCommand}"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsPresenter/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource AppBg}" BorderBrush="#5000F3FF" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource Surface}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Source="Assets/ghostlist.ico" Margin="0,0,9,0"/>
                    <TextBlock Text="{local:Loc app.title}" Foreground="{StaticResource NeonBlue}" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionButton}" Content="—" ToolTip="{local:Loc caption.minimize}" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="▢" ToolTip="{local:Loc caption.maximize}" Click="MaximizeRestore_Click"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="×" ToolTip="{local:Loc caption.close}" Click="Close_Click"/>
                </StackPanel>
                <Border VerticalAlignment="Bottom" Height="1" Background="#5000F3FF"/>
            </Grid>

            <Grid Grid.Row="1" Margin="24,20,24,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Black" Foreground="{StaticResource NeonBlue}" Text="{local:Loc app.heading.first}">
                                <TextBlock.Effect><DropShadowEffect Color="{StaticResource NeonBlueColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
                            </TextBlock>
                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="24" FontWeight="Black" Foreground="{StaticResource NeonPurple}" Text="{local:Loc app.heading.second}">
                                <TextBlock.Effect><DropShadowEffect Color="{StaticResource NeonPurpleColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextDim}" Text="{local:Loc app.tagline}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="10,4" CornerRadius="6" Margin="0,0,10,0" Background="#1AFF00EA" BorderBrush="#50FF00EA" BorderThickness="1"
                                Visibility="{Binding IsLimited, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonPink}" Text="{Binding AdminText}"/>
                        </Border>
                        <Border Padding="10,4" CornerRadius="6" Margin="0,0,10,0" Background="#1A34D399" BorderBrush="#5034D399" BorderThickness="1"
                                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonSuccess}" Text="{Binding AdminText}"/>
                        </Border>
                        <Button Style="{StaticResource QuietButton}" Margin="0,0,10,0" Padding="10,5"
                                Content="{local:Loc admin.restart}" ToolTip="{local:Loc admin.restartTip}"
                                Command="{Binding ElevateCommand}"
                                Visibility="{Binding IsLimited, Converter={StaticResource BoolToVis}}"/>
                        <Border Padding="12,6" BorderBrush="{StaticResource NeonPurple}" BorderThickness="1" CornerRadius="12" Background="#1AB026FF">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#E8C6FF" Text="{local:Loc app.platform}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Style="{StaticResource ViewTab}" Content="{local:Loc tab.findings}"
                                 IsChecked="{Binding ShowFindings, Mode=OneWay}" Command="{Binding ShowFindingsCommand}"/>
                    <RadioButton Style="{StaticResource ViewTab}" Content="{local:Loc tab.backups}"
                                 IsChecked="{Binding ShowBackups, Mode=OneWay}" Command="{Binding ShowBackupsCommand}"/>

                    <Border Margin="16,0,0,0" Padding="12,5" CornerRadius="12" VerticalAlignment="Center"
                            Background="#1A34D399" BorderBrush="#5034D399" BorderThickness="1"
                            Visibility="{Binding Updates.IsVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="13" VerticalAlignment="Center"
                                       Foreground="{StaticResource NeonSuccess}" Text="{Binding Updates.BannerText}"/>
                            <Button Style="{StaticResource QuietButton}" Margin="10,0,0,0"
                                    Content="{local:Loc update.notes}" Command="{Binding Updates.OpenReleaseCommand}"/>
                            <Button Style="{StaticResource QuietButton}" Margin="4,0,0,0"
                                    Content="{local:Loc update.dismiss}" Command="{Binding Updates.DismissCommand}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TextDim}" Text="{Binding Updates.ManualMessage}"
                               Visibility="{Binding Updates.HasManualMessage, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Grid Grid.Row="2" Visibility="{Binding ShowFindings, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/><RowDefinition Height="240"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="8" Margin="0,0,0,10" CornerRadius="12">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Left" Margin="10,0,14,0" Content="{local:Loc filter.brokenOnly}" IsChecked="{Binding BrokenOnly, Mode=TwoWay}"/>
                        <Button DockPanel.Dock="Left" Content="{local:Loc btn.info}" ToolTip="{local:Loc btn.infoTip}" Command="{Binding InfoCommand}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{local:Loc btn.selectAll}" Command="{Binding SelectAllCommand}"/>
                            <Button Content="{local:Loc btn.clearSelection}" Command="{Binding ClearSelectionCommand}"/>
                            <Button Content="{local:Loc btn.rescan}" Command="{Binding ScanCommand}"/>
                            <Button Content="{local:Loc btn.stopScan}" Command="{Binding StopScanCommand}"
                                    Visibility="{Binding Progress.IsRunning, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{local:Loc btn.export}" ToolTip="{local:Loc btn.exportTip}" Command="{Binding ExportReportCommand}"/>
                            <Button Content="{local:Loc btn.diagnostics}" ToolTip="{local:Loc btn.diagnosticsTip}" Command="{Binding ExportDiagnosticsCommand}"/>
                            <Button Content="{local:Loc btn.restore}" Command="{Binding RestoreCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="{local:Loc btn.fixSelected}" Command="{Binding FixSelectedCommand}"/>
                            <Button Style="{StaticResource DangerButton}" Content="{local:Loc btn.fixAll}" Command="{Binding FixAllCommand}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="10,8" Margin="0,0,0,10" CornerRadius="12"
                        BorderBrush="#5000F3FF">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource AnyTrueToVis}">
                            <Binding Path="Progress.IsRunning"/>
                            <Binding Path="Progress.HasFailures"/>
                        </MultiBinding>
                    </Border.Visibility>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" VerticalAlignment="Center"
                                   Margin="2,0,12,0" Text="{local:Loc scan.progress}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MonoValue}" VerticalAlignment="Center"
                                   Margin="12,0,2,0" Foreground="{StaticResource NeonBlue}" Text="{Binding Progress.CountText}"/>
                        <ItemsControl ItemsSource="{Binding Progress.Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,2,8,2" Padding="8,3" CornerRadius="6" Background="#14FFFFFF"
                                            BorderThickness="1" BorderBrush="#20FFFFFF" ToolTip="{Binding Error}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="13" Foreground="{StaticResource TextBody}" Text="{Binding Header}"/>
                                            <TextBlock FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextLabel}" Text="{Binding StateText}"/>
                                        </StackPanel>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#5000F3FF"/>
                                                        <Setter Property="Background" Value="#1A00F3FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#5034D399"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#50FF00EA"/>
                                                        <Setter Property="Background" Value="#1AFF00EA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="2" Margin="12,0,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/><ColumnDefinition Width="110"/><ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc column.select}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc column.finding}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc column.detail}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc column.confidence}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc column.status}"/>
                </Grid>

                <ListBox Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource TextBody}"
                         ItemsSource="{Binding FindingsView}" ItemTemplate="{StaticResource FindingRow}"
                         ItemContainerStyle="{StaticResource FindingItem}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource CategoryHeader}"/>
                    </ListBox.GroupStyle>
                </ListBox>

                <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Margin="0,12,0,0" BorderBrush="#50B026FF">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource H2}" Text="{Binding Selected.Title}" MaxWidth="900"/>
                                <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="6" VerticalAlignment="Center" Background="#1AFF00EA" BorderBrush="#50FF00EA" BorderThickness="1">
                                    <TextBlock FontFamily="{StaticResource FontMono}" FontWeight="Bold" Foreground="{StaticResource NeonPink}" Text="{Binding Selected.ConfidenceText}"/>
                                </Border>
                                <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="6" VerticalAlignment="Center" Background="#1A00F3FF" BorderBrush="#5000F3FF" BorderThickness="1">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonBlue}" Text="{Binding Selected.CategoryText}"/>
                                </Border>
                                <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="6" VerticalAlignment="Center" Background="#1AB026FF" BorderBrush="#50B026FF" BorderThickness="1">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonPurple}" Text="{Binding Selected.StatusText}"/>
                                </Border>
                                <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="6" VerticalAlignment="Center" Background="#1AFF00EA" BorderBrush="#50FF00EA" BorderThickness="1"
                                        Visibility="{Binding Selected.IsLocked, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Selected.LockedText}">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonPink}" Text="{local:Loc detail.locked}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextDim}" Text="{Binding Selected.Subtitle}"/>
                            <TextBlock Style="{StaticResource Label}" Margin="0,12,0,4" Text="{local:Loc evidence.title}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Selected.EvidenceLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Foreground="{StaticResource NeonBlue}" Text="▸" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" MaxWidth="1400"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextHint}" Text="{local:Loc detail.empty}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </Border>
                </Grid>

                <views:BackupsView Grid.Row="2" DataContext="{Binding Backups}"
                                   Visibility="{Binding DataContext.ShowBackups, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                <Grid Grid.Row="3" Margin="2,10,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource LanguageButton}" Content="{local:Loc lang.tr}" Command="{Binding LanguageCommand}" CommandParameter="tr"
                                Foreground="{Binding IsTurkish, Converter={StaticResource ActiveLanguageBrush}}"
                                BorderBrush="{Binding IsTurkish, Converter={StaticResource ActiveLanguageBorder}}"/>
                        <TextBlock Foreground="{StaticResource TextHint}" Text="/" Margin="6,0"/>
                        <Button Style="{StaticResource LanguageButton}" Content="{local:Loc lang.en}" Command="{Binding LanguageCommand}" CommandParameter="en"
                                Foreground="{Binding IsEnglish, Converter={StaticResource ActiveLanguageBrush}}"
                                BorderBrush="{Binding IsEnglish, Converter={StaticResource ActiveLanguageBorder}}"/>
                        <TextBlock Foreground="{StaticResource NeonSuccess}" Text="●" Margin="16,0,6,0"/>
                        <TextBlock Foreground="{StaticResource NeonBlue}" Text="{Binding StatusMessage}" Margin="0,0,14,0" MaxWidth="720"/>
                        <TextBlock Foreground="{StaticResource NeonBlue}" FontFamily="{StaticResource FontMono}" Text="{Binding VersionText}" Margin="0,0,14,0"/>
                        <TextBlock Foreground="{StaticResource TextLabel}" Text="{local:Loc footer.safety}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox Margin="0,0,10,0" VerticalAlignment="Center" Content="{local:Loc update.auto}"
                                  ToolTip="{local:Loc update.autoTip}" IsChecked="{Binding Updates.AutomaticCheck, Mode=TwoWay}"/>
                        <Button Style="{StaticResource QuietButton}" Margin="0,0,14,0"
                                Content="{local:Loc update.check}" ToolTip="{local:Loc update.autoTip}"
                                Command="{Binding Updates.CheckCommand}"/>
                        <TextBlock Margin="0,0,14,0"><Hyperlink Style="{StaticResource FooterLink}" NavigateUri="https://github.com/sponsors/Teknesyum" RequestNavigate="FooterLink_RequestNavigate"><Run Text="{local:Loc footer.sponsor}"/></Hyperlink></TextBlock>
                        <TextBlock><Hyperlink Style="{StaticResource FooterLink}" NavigateUri="https://github.com/Teknesyum" RequestNavigate="FooterLink_RequestNavigate"><Run Text="{local:Loc footer.signature}"/></Hyperlink></TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="0" Grid.RowSpan="2" Background="#C8050507" CornerRadius="12"
                    Visibility="{Binding HasDialog, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource PanelBorder}" Padding="24" MaxWidth="720" VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="#50B026FF" DataContext="{Binding Dialog}">
                    <Border.Effect><DropShadowEffect Color="#FF000000" BlurRadius="40" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,0" Text="{Binding Body}" TextWrapping="Wrap" TextTrimming="None"/>
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Lines}" Visibility="{Binding HasLines, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Foreground="{StaticResource NeonPurple}" Text="▸" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="None" MaxWidth="620"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="{Binding CancelText}" Click="DialogCancel_Click"
                                    Visibility="{Binding AskConfirmation, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" Click="DialogConfirm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
