<UserControl x:Class="Ghostlist.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ghostlist.App"
             Background="Transparent" Foreground="{StaticResource TextBody}">
    <UserControl.Resources>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
            <Setter Property="CaretBrush" Value="{StaticResource NeonBlue}"/>
            <Setter Property="BorderBrush" Value="#3300F3FF"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8000F3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>

        <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A00F3FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3300F3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="BackupRow">
            <Border x:Name="row" Background="Transparent" CornerRadius="8" Padding="0,5" ToolTip="{Binding Target}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CellMono}" FontWeight="Normal"
                               Foreground="{StaticResource TextDim}" Text="{Binding DateText}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CellText}" Text="{Binding DisplayName}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource CellText}" Foreground="{StaticResource TextDim}" Text="{Binding KindText}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource CellMono}" Foreground="{StaticResource NeonPink}" Text="{Binding SizeText}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource CellText}" Text="{Binding StateText}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsReadable}" Value="False">
                    <Setter TargetName="row" Property="Opacity" Value="0.45"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="HistoryRow">
            <Border Background="Transparent" CornerRadius="8" Padding="0,5" ToolTip="{Binding Target}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource CellMono}" FontWeight="Normal"
                               Foreground="{StaticResource TextDim}" Text="{Binding DateText}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource CellText}" Foreground="{StaticResource NeonBlue}" Text="{Binding OperationText}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource CellText}" Foreground="{StaticResource TextDim}" Text="{Binding CategoryText}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource CellText}" Text="{Binding Target}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource CellText}" Text="{Binding ResultText}"/>
                    <Button Grid.Column="5" Style="{StaticResource QuietButton}" HorizontalAlignment="Center"
                            Content="{local:Loc history.reveal}" ToolTip="{local:Loc history.revealTip}"
                            Visibility="{Binding HasBackup, Converter={StaticResource BoolToVis}}"
                            Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="260"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="8" Margin="0,0,0,10" CornerRadius="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" VerticalAlignment="Center"
                           Margin="10,0,8,0" Text="{local:Loc backup.search}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontFamily="{StaticResource FontMono}"
                               Foreground="{StaticResource NeonBlue}" Text="{Binding TotalSizeText}"/>
                    <Button Content="{local:Loc backup.refresh}" Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource DangerButton}" Content="{local:Loc backup.purge}"
                            ToolTip="{Binding PurgeSummaryText}" Command="{Binding PurgeCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{local:Loc backup.restoreSelected}"
                            Command="{Binding RestoreCommand}"/>
                </StackPanel>
                <TextBox Style="{StaticResource SearchBox}" MinWidth="240" Margin="0,0,12,0"
                         Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/><ColumnDefinition Width="90"/><ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc backup.column.date}"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc backup.column.name}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc backup.column.kind}"/>
            <TextBlock Grid.Column="3" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc backup.column.size}"/>
            <TextBlock Grid.Column="4" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc backup.column.state}"/>
        </Grid>

        <Grid Grid.Row="2">
            <ListBox Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource TextBody}"
                     ItemsSource="{Binding Backups}" ItemTemplate="{StaticResource BackupRow}"
                     ItemContainerStyle="{StaticResource RowItem}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     MouseDoubleClick="Backups_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextHint}"
                       Text="{local:Loc backup.empty}"
                       Visibility="{Binding HasBackups, Converter={StaticResource InverseBoolToVis}}"/>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="16" Margin="0,12,0,0" CornerRadius="12"
                BorderBrush="#50B026FF" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel DataContext="{Binding Selected}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource H2}" Text="{Binding DisplayName}" MaxWidth="700"/>
                    <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="6" VerticalAlignment="Center"
                            Background="#1A00F3FF" BorderBrush="#5000F3FF" BorderThickness="1">
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonBlue}" Text="{Binding KindText}"/>
                    </Border>
                    <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="6" VerticalAlignment="Center"
                            Background="#1AB026FF" BorderBrush="#50B026FF" BorderThickness="1">
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonPurple}" Text="{Binding CategoryText}"/>
                    </Border>
                    <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="6" VerticalAlignment="Center"
                            Background="#1AFF00EA" BorderBrush="#50FF00EA" BorderThickness="1">
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource NeonPink}" Text="{Binding StateText}"/>
                    </Border>
                </StackPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Label}" Margin="0,0,12,4" Text="{local:Loc backup.detail.target}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding Target}" ToolTip="{Binding Target}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Margin="0,0,12,4" Text="{local:Loc backup.detail.date}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" FontFamily="{StaticResource FontMono}" Text="{Binding DateText}"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Margin="0,0,12,0" Text="{local:Loc backup.detail.file}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{StaticResource TextDim}" Text="{Binding Path}" ToolTip="{Binding Path}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Margin="0,12,0,0" BorderBrush="#3300F3FF">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource H3}" Text="{local:Loc history.title}"/>
                <Grid Grid.Row="1" Margin="0,10,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc backup.column.date}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc history.column.operation}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc column.category}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc history.column.target}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc history.column.result}"/>
                    <TextBlock Grid.Column="5" Style="{StaticResource Label}" HorizontalAlignment="Center" Text="{local:Loc history.column.backup}"/>
                </Grid>
                <Grid Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryRow}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextHint}"
                               Text="{local:Loc history.empty}"
                               Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
